{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "incremental": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "skipLibCheck": true,
    "types": ["node", "jest"],
    "paths": {
      "@api/*": ["src/api/*"],
      "@application/*": ["src/application/*"],
      "@config/*": ["src/config/*"],
      "@contract/*": ["src/contract/*"],
      "@db/*": ["src/db/*"],
      "@domain/*": ["src/domain/*"],
      "@infra/*": ["src/infra/*"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
